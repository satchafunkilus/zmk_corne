//#define HOST_OS 2

#include <behaviors.dtsi>
#include <behaviors/unicode.dtsi>
#include <behaviors/num_word.dtsi>

#include "zmk-helpers/helper.h"
#include "zmk-helpers/unicode-chars/german.dtsi"
#include "zmk-helpers/unicode-chars/spanish.dtsi"
#include "zmk-helpers/unicode-chars/portuguese.dtsi"
#include "zmk-helpers/unicode-chars/currency.dtsi"

#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// Layer names
#define BASE    0
#define QWE     1
#define GAME    2
#define NAV     3
#define SYM     4
#define NUM     5
#define FUN     6
#define UML     7
#define UMLQ    8
#define ACC     9
#define MOUSE   10 //defined in choco_cirque.keymap

// Symbols for better visibility in keymap:
#define ___     &none
#define oooo    &trans

// Additional includes defined down here, because layer names are required
#include "./nodefree/makros_nodefree.dtsi"

// Define timings for core behaviors
&lt {
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
};

&sk {
    release-after-ms = <2000>;
    quick-release;
};
&uc {
    default-mode = <UC_MODE_WIN_COMPOSE>; //Default unicode setup to Windows. Can be switched by combo
    win-compose-key = <RALT>;
    /* minimum-length = <4>; */
};
/ {
    // Include separate files for better overview
    //#include "makros.dtsi"
    #include "behaviors.dtsi"
    #include "combos.dtsi"

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
            //╭──────────────┬──────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
            &mt LG(LA(K)) ESC   &kp Q          &kp W        &kp F          &kp P         &kp B              &kp J       &kp L         &kp U         &kp Y         &kp BSPC       &kp BSPC
            //├──────────────┼──────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                &kp TAB         &hml RGUI A    &hml LALT R  &hml LSHFT S   &hml LCTRL T  &kp G              &kp M       &hmr RCTRL N  &hmr RSHFT E  &hmr LALT I   &hmr LGUI O    &kp SQT
            //├──────────────┼──────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                &caps_word      &kp Z          &kp X        &kp C          &kp D         &kp V              &kp K       &kp H         &comma_semi     &dot_col    &kp FSLH       &kp LGUI
            //╰──────────────┴──────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────┴─────────────╯
                                                             &lt FUN TAB  &htak NAV 0    &kp SPACE          &kp ENTER   &lt NUM BSPC  &lt SYM DEL
            //                                            ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
            >;
            sensor-bindings = <&inc_dec_kp LEFT RIGHT>;
            label = "Base";
        };

        qwertz_layer {
            bindings = <
            //╭──────────────┬──────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
            &mt LG(LA(K)) ESC   &kp Q          &kp W         &kp E         &kp R         &kp T            &kp Z          &kp U         &kp I         &kp O         &kp P         &kp BSPC
            //├──────────────┼──────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
            &kp TAB             &kp A          &hml LALT S   &hml LSHFT D  &hml LCTRL F  &kp G            &kp H          &hmr RCTRL J  &hmr RSHFT K  &hmr LALT L   &kp SEMI      &kp SQT
            //├──────────────┼──────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
            &sk LSHFT           &kp Y          &kp X         &kp C         &kp V         &kp B            &kp N          &kp M         &comma_semi   &dot_col      &kp FSLH      &kp LGUI
            //╰──────────────┴──────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────┴─────────────╯
                                                            &lt FUN TAB    &htak NAV 0   &kp SPACE        &kp ENTER      &lt NUM BSPC  &lt SYM DEL
            //                                            ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
            >;
            sensor-bindings = <&inc_dec_kp LEFT RIGHT>;
            label = "QWERTZ";
        };

        game_layer {
            bindings = <
            //╭──────────────┬──────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
                &kp ESC         &kp Q          &kp W        &kp F          &kp P         &kp B              &kp J       &kp L         &kp U         &kp Y         &kp SEMICOLON  &kp BSPC
            //├──────────────┼──────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                &kp TAB         &kp A          &kp R        &kp S          &kp T         &kp G              &kp M       &hmr RCTRL N  &hmr RSHFT E  &hmr LALT I   &hmr LGUI O    &kp SQT
            //├──────────────┼──────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                &kp LSHFT       &kp Z          &kp X        &kp C          &kp D         &kp V              &kp K       &kp H          &comma_semi   &dot_col     &kp FSLH       &kp LGUI
            //╰──────────────┴──────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────┴─────────────╯
                                                             &lt FUN TAB  &htak NUM 0    &kp SPACE          &kp ENTER   &lt NAV BSPC  &lt SYM DEL
            //                                            ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
            >;
            sensor-bindings = <&inc_dec_kp LEFT RIGHT>;
            label = "Game";
        };

        nav_layer {
            bindings = <
            //╭──────────────┬──────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
                &kp ESC         ___             ___         &ppt_fp        &kp LS(TAB)  &swapper          &kp LC(Y)     &kp LC(V)     &kp LC(C)     &kp LC(X)      &kp LC(Z)      ___
            //├──────────────┼──────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                &kp TAB         &kp LGUI        &kp LALT    &kp LSHFT      &kp LCTRL    &kp LC(Z)         &kp PRINTSCREEN &kp LEFT    &kp DOWN      &kp UP         &kp RIGHT      ___
            //├──────────────┼──────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                &kp LSHFT       &kp LC(Z)       &kp LC(X)   &kp LC(C)   &kp PRINTSCREEN &kp LC(V)         &kp INS       &kp HOME      &kp PG_DN     &kp PG_UP      &kp END        ___
            //╰──────────────┴──────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────┴─────────────╯
                                                            ___            ___          ___               &kp RETURN    &kp DEL       ___
            //                                            ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
            >;

            label = "Navi";
        };

        symbol_layer {
            bindings = <
            //╭──────────────┬──────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
                &kp ESC       &kp KP_PLUS      &kp EXCL       &kp AT        &kp HASH      &kp GRAVE        &kp CARET    &kp AMPS    &kp KP_MULTIPLY  &kp LPAR       &kp RPAR    &kp BSPC
            //├──────────────┼──────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                &kp TAB       &kp KP_MINUS     &kp DLLR       &kp PRCNT     &kp CARET     &kp TILDE        &kp MINUS    &kp EQUAL      &kp DQT        &kp SQT       &kp PIPE    &kp GRAVE
            //├──────────────┼──────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                &kp LSHFT     &kp KP_ASTERISK  &kp AMPS   &kp KP_MULTIPLY   &kp LPAR      &kp RPAR         &kp UNDER    &kp PLUS       &kp LBRC      &kp RBRC       &kp BSLH    &kp TILDE
            //╰──────────────┴──────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────┴─────────────╯
                                                              ___           &kp SPACE     ___              ___          ___            ___
            //                                            ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
            label = "Symbol";
        };

        num_layer {
            bindings = <
            //╭──────────────┬──────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
                &tog NUM      &kp KP_PLUS      &kp N1        &kp N2       &kp N3        &kp KP_DIVIDE      ___           ___           ___           ___            ___            ___
            //├──────────────┼──────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                oooo          &kp KP_MINUS     &kp N4        &kp N5       &kp N6        &kp DOT            &kp PRINTSCREEN &kp LEFT    &kp DOWN      &kp UP         &kp RIGHT      ___
            //├──────────────┼──────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                oooo          &kp KP_ASTERISK  &kp N7        &kp N8       &kp N9        &kp COMMA          &kp INS       &kp HOME      &kp PG_DN     &kp PG_UP      &kp END        ___
            //╰──────────────┴──────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────┴─────────────╯
                                                             &kp DELETE   &kp N0        &kp SPACE          &kp RETURN    &tog NUM      ___
            //                                            ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
            >;
            sensor-bindings = <&inc_dec_kp UP DOWN>;
            label = "Number";
        };

        function_layer {
            bindings = <
            //╭──────────────┬──────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
                 ___          &bt BT_SEL 0   &out OUT_TOG   &kp C_PREV    &kp C_NEXT    &kp C_VOL_UP        &kp F1       &kp F2        &kp F3        &kp F4        &tog QWE        ___
            //├──────────────┼──────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                 ___          &bt BT_SEL 1      ___         &kp LSHFT     &kp C_PP      &kp C_VOL_DN        &kp F5       &kp F6        &kp F7        &kp F8        &tog NUM        ___
            //├──────────────┼──────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                 ___          &bt BT_SEL 2  &bt BT_CLR        ___         ___           &kp C_MUTE          &kp F9       &kp F10       &kp F11       &kp F12       &studio_unlock  ___
            //╰──────────────┴──────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────┴─────────────╯
                                                              ___         ___           ___                 ___          ___           ___
            //                                            ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
            >;

            label = "Function";
        };

        umlaut_layer {
            bindings = <
            //╭──────────────┬──────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
                oooo            oooo            oooo        oooo            oooo         oooo               oooo         oooo          &uc UC_DE_UE   oooo         oooo           oooo
            //├──────────────┼──────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                oooo            &uc UC_DE_AE    &curr_euro  &uc UC_DE_SS    oooo         &degr              oooo         &uc UC_ES_N_TILDE &curr_euro oooo         &uc UC_DE_OE   oooo
            //├──────────────┼──────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                oooo            oooo            oooo        &uc UC_ES_C_CEDILLA oooo     oooo               oooo         oooo          oooo           oooo         oooo           oooo
            //╰──────────────┴──────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────┴─────────────╯
                                                            oooo            &sl ACC      oooo               oooo         oooo          oooo
            //                                            ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
            >;

            label = "Umlaut";
        };

        umlaut_layer_qwertz {
            bindings = <
            //╭──────────────┬──────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
                oooo            oooo            oooo        &curr_euro      oooo         oooo             oooo          &uc UC_DE_OE   oooo         &uc UC_DE_UE   oooo         oooo
            //├──────────────┼──────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                oooo            &uc UC_DE_AE    &uc UC_DE_SS oooo           oooo         &degr            oooo           oooo          oooo         oooo           oooo         oooo
            //├──────────────┼──────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                oooo            oooo            oooo        &uc UC_ES_C_CEDILLA oooo     oooo          &uc UC_ES_N_TILDE oooo          oooo         oooo           oooo         oooo
            //╰──────────────┴──────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────┴─────────────╯
                                                            oooo            &sl ACC      oooo               oooo         oooo          oooo
            //                                            ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
            >;

            label = "Umlaut Q";
        };

        accent_layer {
            bindings = <
            //╭──────────────┬──────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
                oooo            oooo            oooo        oooo            oooo         oooo               &a_gr         &e_gr         &i_gr         &o_gr         &u_gr         oooo
            //├──────────────┼──────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                oooo            &a_tild         &kp LALT    &kp LSHFT      &kp LCTRL     oooo               &a_acu        &e_acu        &i_acu        &o_acu        &u_acu        oooo
            //├──────────────┼──────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                oooo            oooo            oooo        &cedi           oooo         oooo               &a_circ       &e_circ       &i_circ       &o_circ       &u_circ       oooo
            //╰──────────────┴──────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────┴─────────────╯
                                                            oooo            oooo         oooo               oooo         oooo          oooo
            //                                            ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
            >;

            label = "Accent";
        };
    };
};
