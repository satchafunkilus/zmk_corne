
#include "./nodefree/keypos_42keys.h"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/mouse.h>

// Homerow Mod Keymaps
#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5  // left hand
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5  // right hand
#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2                                      // thumbs


#include "base.keymap"



// Functions for Cirque Trackpad
&glidepoint_listener {
    // Activating trackpad switches to MOUSE layer for 2000ms
    input-processors = <&zip_temp_layer	MOUSE 2000>;

    // When in the function layer, use trackpad for scrolling instead of pointer movement
    scroller {
        layers = <FUN>;
        input-processors = <&zip_xy_to_scroll_mapper>, <&zip_scroll_scaler 1 8>;
    };
};


/ {
    // Add Mouse layer to base-keymap
    keymap {
        compatible = "zmk,keymap";

        mouse_layer {
            bindings = <
            //╭──────────────┬──────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
                oooo            oooo           oooo         oooo           oooo          &msc SCRL_UP       oooo        oooo          oooo          oooo          oooo           oooo
            //├──────────────┼──────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                oooo            &kp LGUI        &kp LALT    &kp LSHFT      &kp LCTRL     &msc SCRL_DOWN     oooo        oooo          oooo          oooo          oooo           oooo
            //├──────────────┼──────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                &kp LC(Z)       &kp LC(X)       &kp LC(C)   &kp LC(V)      oooo          &mkp MCLK          oooo        oooo          oooo          oooo          oooo           oooo
            //╰──────────────┴──────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────┴─────────────╯
                                                            oooo           &mkp RCLK     &mkp LCLK          oooo        oooo          oooo
            //                                            ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
            >;
            label = "Mouse";
        };


    };
};